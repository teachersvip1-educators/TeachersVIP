{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true
  },
  "include": ["server/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["server/**/*.test.ts", "scripts/**/*.test.ts"]
}
